# Sema — environment template.
# Copy to .env and fill in. NEVER commit a real .env (see .gitignore).
# Placeholder values only: no real secrets belong in this file.

# ─────────────────────────── Runtime ───────────────────────────
NODE_ENV=development
LOG_LEVEL=info

# ─────────────────────────── apps/api ──────────────────────────
API_PORT=3001
API_HOST=0.0.0.0
# Public origin of the API. Used to build Meta / Daraja callback URLs.
API_PUBLIC_URL=http://localhost:3001
# Comma-separated origins allowed to call the API with credentials (the inbox).
CORS_ORIGINS=http://localhost:3000

# ─────────────────────────── apps/inbox ────────────────────────
INBOX_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# ─────────────────────────── Postgres ──────────────────────────
# Matches docker-compose.yml. Managed Postgres in staging/prod (Neon or
# Supabase, region eu-central / af-south) — append ?sslmode=require there.
DATABASE_URL=postgres://sema:sema@localhost:5432/sema
# Migration-only role. Never used by the API or workers (RLS must not be
# bypassed by request paths — CLAUDE.md hard rule 8).
DATABASE_MIGRATION_URL=postgres://sema:sema@localhost:5432/sema
# Optional: a separate database for `pnpm test:integration`. When unset, the
# tests use DATABASE_URL, then the docker-compose default, then skip.
# In any environment holding real patient data, DATABASE_URL must point at the
# unprivileged `sema_app` role — superusers bypass RLS (packages/db/README.md).
# TEST_DATABASE_URL=postgres://sema:sema@localhost:5432/sema_test

# ─────────────────────────── Redis / BullMQ ────────────────────
REDIS_URL=redis://localhost:6379
# Prefix so multiple environments can share a Redis instance safely.
QUEUE_PREFIX=sema

# ─────────────────────────── Anthropic ─────────────────────────
# Phase 4+. Zero-retention settings are mandatory (CLAUDE.md hard rule 4).
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# ─────────────────────────── WhatsApp Cloud API (Phase 3) ──────
WHATSAPP_APP_ID=REPLACE_ME
WHATSAPP_APP_SECRET=REPLACE_ME
# Token echoed back on Meta's GET webhook verification handshake.
WHATSAPP_VERIFY_TOKEN=REPLACE_ME_RANDOM_STRING
WHATSAPP_GRAPH_VERSION=v20.0

# ─────────────────────────── M-Pesa Daraja (Phase 6) ───────────
# Per-clinic credentials live encrypted in the DB; these are the sandbox
# defaults used by pnpm mpesa:simulate only.
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=REPLACE_ME
DARAJA_CONSUMER_SECRET=REPLACE_ME

# ─────────────────────────── Secrets / crypto ──────────────────
# 32-byte base64 master key wrapping per-tenant DEKs (ARCHITECTURE.md §9).
ENCRYPTION_MASTER_KEY=REPLACE_ME_BASE64_32_BYTES
# Signs staff session cookies.
SESSION_SECRET=REPLACE_ME_LONG_RANDOM_STRING

# ─────────────────────────── Observability ─────────────────────
# Leave empty locally. No PHI is ever sent to these (hard rule 4).
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
